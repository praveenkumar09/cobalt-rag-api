{
  "uid": "cobalt-rag-overview",
  "title": "Cobalt RAG — Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["cobalt", "rag", "genai"],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Answer quality",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Out-of-scope rate",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum(rate(rag_answers_total{outcome=\"out_of_scope\"}[15m])) or vector(0)) / sum(rate(rag_answers_total[15m]))",
          "legendFormat": "out-of-scope %"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Avg chunks retrieved / question",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(rag_chunks_retrieved_sum[15m]) / rate(rag_chunks_retrieved_count[15m])",
          "legendFormat": "avg chunks"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Questions with graph context",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (sum(rate(rag_graph_context_total{has_context=\"true\"}[15m])) or vector(0)) / sum(rate(rag_graph_context_total[15m]))",
          "legendFormat": "has graph context %"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Impact-analysis triggers (1h)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rag_impact_analysis_triggered_total[1h])) or vector(0)",
          "legendFormat": "triggers"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Answers: in-scope vs out-of-scope",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(rag_answers_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "LLM call health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM call rate by type",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (type) (rate(llm_calls_seconds_count[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM call p95 latency by type",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, type) (rate(llm_calls_seconds_bucket[5m])))",
          "legendFormat": "{{type}} p95"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "LLM call errors by type",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (type) (rate(llm_call_errors_total[5m]))",
          "legendFormat": "{{type}} errors"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP request rate (/api/ask*)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{uri=~\"/api/ask.*\"}[5m]))",
          "legendFormat": "{{uri}} [{{status}}]"
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "System health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "HTTP p95 latency (all endpoints)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{uri}} p95"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "JVM heap used",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "heap used"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Postgres pool — active connections",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_active",
          "legendFormat": "active connections"
        }
      ]
    },
    {
      "id": 16,
      "type": "row",
      "title": "Security",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Prompt injection attempts (24h)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 42 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 }
      ] } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT COUNT(*) AS count FROM security_events WHERE violation_type = 'prompt_injection' AND created_at > now() - interval '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "type": "stat",
      "title": "PII requested (24h)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 42 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 1 }
      ] } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT COUNT(*) AS count FROM security_events WHERE violation_type = 'pii_requested' AND created_at > now() - interval '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "stat",
      "title": "PII volunteered by user (24h)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 42 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "orange", "value": 1 }
      ] } }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "rawSql": "SELECT COUNT(*) AS count FROM security_events WHERE violation_type = 'pii_provided' AND created_at > now() - interval '24 hours'",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Security violations by type",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (type) (rate(rag_security_violations_total[15m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Rate-limit rejections (rate)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(rag_rate_limit_exceeded_total[15m])) or vector(0)",
          "legendFormat": "rejected/s"
        }
      ]
    },
    {
      "id": 22,
      "type": "text",
      "title": "",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 56 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "mode": "markdown", "content": "" },
      "transparent": true
    }
  ]
}
